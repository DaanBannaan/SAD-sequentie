@startuml
'
autonumber

'Element Declaration Syntax:

'Person(alias, "label", [descr], [sprite], [tags], [link])
'Container(alias, "label", "technology", [descr], [sprite], [tags], [link])
'Rel(from, to, "label", [technology], [descr], [sprite], [tags], [link])
'Rel_Response(from, to, "label", [technology], [descr], [sprite], [tags], [link])

'Person(user, "Speler")
'Component(configuration, "Configuration-Service", "Hier kan het gedrag van een agent aangepast worden en kunnen nieuwe modules toegevoegd worden.")
'Component(world, "World-Service", "Hier vindt de wereldgeneratie plaats en bevind zich de wereldstatus.")
'Component(engine, "Game-Engine-Service", "Deze component bevat de logica van het spel zelf.")
'Component(agent, "Agent-Service", "Deze component bevat de logica van een agent.")
'Component(player, "Player-Service", "Deze component bevat de logica van een karakter.")
'Component(monster, "Monster-Service", "Deze component bevat de logica van een monster.")
'Component(save, "Save-and-Load-Service", "Deze component regelt het laden en opslaan van het spel.")
'Component(communication, "Communication-Protocol", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
'Component(cli, "CLI-Service", "Dit is de frontend terminal waarmee spelers kunnen communiceren met de game.")
'Component(chat, "Chat-Service", "Via dit component kunnen spelers met elkaar chatten.")
'Component(logging, "Logging-Service", "Hier worden CPU gebruik, RAM gebruik, aantal spelers, netwerkvertraging, connecties, gevechten, agent-overnames, fouten en saves gelogd.")
'Component(room, "Room-Service", "Hier verzamelen spelers zich voordat een game begint.")


!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

title Speler joint een bestaande room

Person(user, "Speler")

Component(cli1, "CLI-Service [1]", "Frontend terminal waar de spelers gebeurtenissen kunnen zien.")
Component(engine, "Game-Engine-Service", "Deze component bevat de logica van het spel zelf.")
Component(communication, "Communication-Protocol", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
Component(room1, "Room-Service [1]", "Hier verzamelen spelers zich voordat een game begint.")
Component(room2, "Room-Service [2]", "Hier verzamelen spelers zich voordat een game begint.")
Component(cli2, "CLI-Service [2]", "Frontend terminal waar de spelers gebeurtenissen kunnen zien.")
Component(logging, "Logging-Service", "Hier worden gebeurtenissen en fouten gelogd.")

Person(owner, "Host-speler")

Rel(user, engine, "Geeft aan room te willen zoeken")
Rel(engine, communication, "zoekRooms()")
Rel(communication, room1, "zoekRooms()")


Rel(room1, cli1, "beschikbareRooms: List<Room>")
Rel(cli1, user, "Toon beschikbare rooms")


Rel(user, engine, "kiest room om te joinen")
Rel(engine, communication, "joinRoom(roomID)")
Rel(communication, room1, "joinRoom(roomID)")


alt Room bestaat niet of is niet toegankelijk
Rel(room1, cli1, "error room niet toegankelijk")
else Room bestaat en is toegankelijk
Rel(room1, logging, "logSpelerJoin()")
Rel(communication, room2, "toonStatus(room)")
Rel(room1, cli1, "toonRoom(room)")
Rel(cli1, user, "Toont room en deelnemers")
autonumber 12
Rel(room2, cli2, "toonRoom(room)")
autonumber 13
Rel(cli2, owner, "Toont room en deelnemers")
end

@enduml
