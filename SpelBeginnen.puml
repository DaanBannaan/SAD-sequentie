@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

autonumber

'Person(user, "Speler")
'Component(configuration, "Configuration-Service", "Hier kan het gedrag van een agent aangepast worden en kunnen nieuwe modules toegevoegd worden.")
'Component(world, "World-Service", "Hier vindt de wereldgeneratie plaats en bevind zich de wereldstatus.")
'Component(engine, "Game-Engine-Service", "Deze component bevat de logica van het spel zelf.")
'Component(agent, "Agent-Service", "Deze component bevat de logica van een agent.")
'Component(player, "Player-Service", "Deze component bevat de logica van een karakter.")
'Component(monster, "Monster-Service", "Deze component bevat de logica van een monster.")
'Component(save, "Save-and-Load-Service", "Deze component regelt het laden en opslaan van het spel.")
'Component(communication, "Communication-Protocol", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
'Component(cli, "CLI-Service", "Frontend terminal waar de spelers gebeurtenissen kunnen zien.")
'Component(chat, "Chat-Service", "Via dit component kunnen spelers met elkaar chatten.")
'Component(logging, "Logging-Service", "Hier worden CPU gebruik, RAM gebruik, aantal spelers, netwerkvertraging, connecties, gevechten, agent-overnames, fouten en saves gelogd.")
'Component(room, "Room-Service", "Hier verzamelen spelers zich voordat een game begint.")

title Spel beginnen

Person(host, "Host-Speler")
Component(cli, "CLI-Service [Host-speler]", "Frontend terminal waar de spelers gebeurtenissen kunnen zien.")
Component(room, "Room-Service [Host-speler]", "Hier verzamelen spelers zich voordat een game begint.")
Component(communication, "Communication-Protocol [Host-speler}", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
Component(engine, "Game-Engine-Service [Host-speler]", "Deze component bevat de logica van het spel zelf.")
Component(world, "World-Service [Host-speler]", "Hier vindt de wereldgeneratie plaats en bevind zich de wereldstatus.")
Component(world2, "World-Service [Andere spelers]", "Hier vindt de wereldgeneratie plaats en bevind zich de wereldstatus.")
Component(engine2, "Game-Engine-Service [Andere spelers]", "Deze component bevat de logica van het spel zelf.")
Component(communication2, "Communication-Protocol [Andere spelers]", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
Component(room2, "Room-Service [Andere spelers]", "Hier verzamelen spelers zich voordat een game begint.")
Component(cli2, "CLI-Service [Andere spelers]", "Frontend terminal waar de spelers gebeurtenissen kunnen zien.")
Person(user, "Andere spelers")
'Rel(room, room, "startCountdown(startCountdownValue)")
'loop while countdown not complete or amountOfPlayers < minimumAmountOfPlayers
'
'alt Room contains 30<players<40 && countdown < 5 minutes
'Rel(room, room, "startCountdown(5 minutes)")
'else Room contains 40>players<maxPlayers  && countdown < 30 seconds
'Rel(room, room, "startCountdown(30 seconds)")
'end
'Rel(room, room, "checkAmountOfPlayers")
'Rel(room, cli, "showCountdown()")
'end loop

Rel(host, cli, "Geeft aan dat hij het spel wil beginnen.")
Rel(cli, engine, "startGame()")
Rel(engine, room, "gameStarting()")
Rel(room, room, "saveRoomInfo()")
Rel(room, room2, "gameStarting(roomInfo)")
note right: roominfo object bevat: list<Player> players, int agentAmount, String gamemode
Rel(room2, cli2, "showLoading()")
autonumber 6
Rel(room, cli, "showLoading()")
Rel(cli2, user, "ziet laadscherm")
autonumber 7
Rel(cli, host, "ziet laadscherm")

Rel(room2, engine2, gameStarting(roomInfo))
Rel(engine2, room2, "shutdownRoomService()")
autonumber 10
Rel(engine2, communication2, activateCommunicationProtocol(players))
note right: communication-protocol van alle andere spelers is nu actief op zoek naar andere nodes en gebruikt hiervoor de spelerinfo-list die is meegegeven
autonumber 8
Rel(engine, room, "shutdownRoomService()")
Rel(room, engine, "Roominfo roomInfo")
note right: Bevat: String gamemode, list<Player> players, int agentAmount
Rel(engine, world, "createNewWorld()")
note right: Unieke wereld is gegenereerd.
Rel(engine, engine, "initBeings(agentAmount)")


autonumber 12
Rel(engine, communication, "activateCommunicationProtocol(players)")
note left: communication-protocol van alle host-speler is nu actief op zoek naar andere nodes en gebruikt hiervoor de spelerinfo-list die is meegegeven
alt alle nodes hebben elkaar gevonden
Rel(communication, engine, "allPlayersConnected()")
else één of meerdere nodes nog niet gevonden
Rel(host, cli, geeft aan toch het spel te willen starten)
Rel(cli, engine, startGameAnyway())
end alt
Rel(engine, communication, "sendGameData(gameData)")
Rel(communication, communication2, "loadGame(gameData)")
Rel(communication2, engine2, "loadGame(gameData)")
Rel(engine2, world2, "loadGame(gameData)")

Rel(communication, cli, "ShowGameStarted()")
autonumber 20
Rel(communication2, cli2, "ShowGameStarted()")
Rel(cli, host, "game is gestart")
autonumber 21
Rel(cli2, user, "game is gestart")
loop
Rel(communication, communication2, "")
Rel(communication2, communication, "")
end loop

'room service is geen peer to peer, communication protocol wel. Roomservice en communication protocol moeten op dezelfde hoogte staan








@enduml