!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

title Speler pauzeert spel

Person(user, "Speler")

Component(cli, "CLI-Service", "Frontend terminal via waar de spelers de game bedienen")
Component(engine1, "Game-Engine-Service [1]", "Deze component bevat de logica van het spel zelf.")
Component(communication, "Communication-Protocol", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
Component(engine2, "Game-Engine-Service [2]", "Deze component bevat de logica van het spel zelf.")
Component(world, "World-Service", "Hier vindt de wereldgeneratie plaats en bevind zich de wereldstatus.")

Rel(user, engine1, "Geeft aan spel te willen pauzeren")
Rel(engine1, world, "pauzeerSpel()")
Rel(engine1, communication, "pauzeerSpel()")
note top
Voor elke speler moet het spel gepauzeert worden
end note
Rel(communication, engine2, "pauzeerSpel()")
Rel(engine2, world, "pauzeerSpel()")










@enduml
