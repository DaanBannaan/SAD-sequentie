
@startuml
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FFFFE6
  BorderColor #444444
}

actor "Speler" as Speler
actor "Menselijke-speler" as Mens
actor "AI-agent" as AI
actor "Developer" as Developer

' Overerving van actoren
Mens --|> Speler
AI --|> Speler

rectangle "Spelsysteem en ontwikkelomgeving" {

    usecase "UCS01\nSpelsessie opstarten" as UCS01
    usecase "UCS04\nActie uitvoeren met karakter" as UCS04
    usecase "UCS06\nOvername AI-agent" as UCS06

    usecase "UCMS-01\nSpel pauzeren en hervatten" as UCMS01
    usecase "UCMS-02\nChatten met medespelers" as UCMS02
    usecase "UCD-02\nSpel joinen" as UCMSO3
    usecase "UCMS-04\nAI-agent programmeren" as UCMS04

    usecase "UCD-02\nFeatures toevoegen (tijdens speluitvoering)" as UCD02

}

' Relaties speler
Speler -- UCS01
Speler -- UCS04
Speler -- UCS06
AI -- UCS06

' Relaties menselijke-speler
Mens -- UCMS01
Mens -- UCMS02
Mens -- UCMS04
Mens -- UCMSO3

' Relaties developer
Developer -- UCD02

' Verplichte onderdelen
UCS04 ..> UCS01 : <<include>>
UCMS02 ..> UCS01 : <<include>>
UCMS01 ..> UCS01 : <<include>>


@enduml
