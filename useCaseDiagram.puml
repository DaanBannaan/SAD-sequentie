
@startuml
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FFFFE6
  BorderColor #444444
}

actor "Speler" as Speler
actor "Menselijke-speler" as Mens
actor "AI-agent" as AI
actor "Beheerder" as Beheerder

' Overerving van actoren
Mens --|> Speler
AI --|> Speler

rectangle "Spelsysteem en ontwikkelomgeving" {

    usecase "UC1\nSpelsessie opstarten" as UC1
    usecase "UC2\nActie uitvoeren met karakter" as UC2
    usecase "UC4\nOvername AI-agent" as UC4

    usecase "UC5\nSpel pauzeren en hervatten" as UC5
    usecase "UC6\nChatten met medespelers" as UC6
    usecase "UC8\nSpel joinen" as UC8
    usecase "UC7\nAI-agent programmeren" as UC7

    usecase "UC3\nFeatures toevoegen (tijdens speluitvoering)" as UC3

}

' Relaties speler
Speler -- UC2
Speler -- UC6
Speler -- UC5

' relaties AI-agent
AI -- UC4

' Relaties menselijke-speler
Mens -- UC1
Mens -- UC5
Mens -- UC7
Mens -- UC8

' Relaties beheerder
Beheerder -- UC3

' Verplichte onderdelen
UC5 ..> UC1 : <<include>>
UC2 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>


@enduml
