@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

autonumber

'Person(user, "Speler")
'Component(configuration, "Configuration-Service", "Hier kan het gedrag van een agent aangepast worden en kunnen nieuwe modules toegevoegd worden.")
'Component(world, "World-Service", "Hier vindt de wereldgeneratie plaats en bevind zich de wereldstatus.")
'Component(engine, "Game-Engine-Service", "Deze component bevat de logica van het spel zelf.")
'Component(agent, "Agent-Service", "Deze component bevat de logica van een agent.")
'Component(player, "Player-Service", "Deze component bevat de logica van een karakter.")
'Component(monster, "Monster-Service", "Deze component bevat de logica van een monster.")
'Component(save, "Save-and-Load-Service", "Deze component regelt het laden en opslaan van het spel.")
'Component(communication, "Communication-Protocol", "Hiermee kunnen verschillende nodes (spelers) met elkaar communiceren, zodat ze synchroon lopen.")
'Component(cli, "CLI-Service", "Dit is de frontend terminal waarmee spelers kunnen communiceren met de game.")
'Component(chat, "Chat-Service", "Via dit component kunnen spelers met elkaar chatten.")
'Component(logging, "Logging-Service", "Hier worden CPU gebruik, RAM gebruik, aantal spelers, netwerkvertraging, connecties, gevechten, agent-overnames, fouten en saves gelogd.")
'Component(room, "Room-Service", "Hier verzamelen spelers zich voordat een game begint.")

title Speler opent een room

Person(user1, "Speler1")
Person(user2, "Speler2")
Component(cli1, "CLI-Service_1", "Dit is de frontend terminal waarmee spelers kunnen communiceren met de game.")
Component(cli2, "CLI-Service_2", "Dit is de frontend terminal waarmee spelers kunnen communiceren met de game.")
Component(room, "Room-Service", "Hier verzamelen spelers zich voordat een game begint.")


Rel(user1, cli, "Geeft aan een room te willen openen")
Rel(cli1, room, "openRoom()")
Rel(room, room, "createRoom()")
Rel(room, room, "broadcastRoom()")
loop Zolang room open en spel nog niet begonnen
Rel(room, room, "checkRoomStatus()")
Rel(room, cli1, "room: Room")
Rel(room, cli2, "room: Room")
Rel(cli1, user1, "Toon roomstatus")
Rel(cli1, user2, "Toon roomstatus")


@enduml